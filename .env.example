# Any OpenAI-compatible Chat Completions endpoint (OpenAI, Azure OpenAI, OpenRouter, Groq,
# Together, Mistral, a local vLLM / Ollama / LM Studio server, ...)
CSG_BASE_URL=https://api.openai.com/v1
CSG_MODEL=gpt-4o-mini
CSG_API_KEY=
# Optional
# CSG_TEMPERATURE=0.2
# CSG_TIMEOUT_MS=120000
# CSG_MAX_RETRIES=3
# CSG_JSON_MODE=1        # set to 0 if your server rejects response_format
# CSG_CONCURRENCY=3
